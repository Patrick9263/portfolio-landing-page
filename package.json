{
  "name": "portfolio",
  "version": "0.1.1",
  "private": true,
  "homepage": "https://patricksmith.io",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-photo-album": "^2.3.0",
    "typewriter-effect": "^2.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "sharp": "^0.35.4",
    "vite": "^8.0.16"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\" \"tests/**/*.mjs\" \"playwright.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json,md}\" \"tests/**/*.mjs\" \"playwright.config.js\"",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"tests/**/*.mjs\" \"playwright.config.js\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" \"tests/**/*.mjs\" \"playwright.config.js\" --fix",
    "photos:build": "node scripts/build-photos.mjs",
    "photos:import": "node scripts/build-photos.mjs import-album",
    "photos:prune": "node scripts/build-photos.mjs prune-album",
    "test:photos": "node --test scripts/build-photos.test.mjs",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
